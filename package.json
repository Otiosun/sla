{
  "name": "pokemon-rpg-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic and narrative-safe Pokemon RPG engine for WhatsApp.",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "dev:simulator:whatsapp": "node --env-file-if-exists=.env --import tsx scripts/operations/run-whatsapp-simulator.ts",
    "start": "node --env-file=.env --import tsx src/main.ts",
    "start:prod": "node dist/src/main.js",
    "start:player-portal:prod": "node dist/src/player-portal-main.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/platform/db/cli.ts migrate",
    "db:verify": "node --env-file-if-exists=.env --import tsx src/platform/db/cli.ts verify",
    "db:seed:phase4": "node --env-file-if-exists=.env --import tsx db/seeds/phase4_vertical_slice.ts",
    "db:seed:phase5": "node --env-file-if-exists=.env --import tsx db/seeds/phase5_player_slice.ts",
    "db:seed:phase6": "node --env-file-if-exists=.env --import tsx db/seeds/phase6_economy_slice.ts",
    "db:seed:phase7": "node --env-file-if-exists=.env --import tsx db/seeds/phase7_world_slice.ts",
    "db:seed:phase11:provisional": "node --env-file-if-exists=.env --import tsx db/seeds/phase11_progression_slice.ts",
    "db:seed:phase11:final": "node --env-file-if-exists=.env --import tsx db/seeds/phase11_trainer_final_slice.ts",
    "db:seed:phase11": "pnpm db:seed:phase11:provisional && pnpm db:seed:phase11:final",
    "db:seed:phase12": "node --env-file-if-exists=.env --import tsx db/seeds/phase12_admin_registry_slice.ts",
    "ops:bootstrap:admin": "node --env-file-if-exists=.env --import tsx scripts/operations/bootstrap-initial-admin.ts",
    "ops:bootstrap:content": "node --env-file-if-exists=.env --import tsx scripts/operations/staging-content-bootstrap.ts",
    "ops:bootstrap:whatsapp": "node --env-file-if-exists=.env --import tsx scripts/operations/bootstrap-whatsapp-session.ts",
    "ops:cleanup:uat-integration-debris": "node --import tsx scripts/operations/cleanup-uat-integration-debris.ts",
    "ops:transition:legacy-postgres-roles": "node --import tsx scripts/operations/transition-legacy-postgres-roles.ts",
    "ops:docs:verify": "node --import tsx scripts/operations/verify-operator-docs.ts",
    "ops:smoke:application": "node --import tsx scripts/operations/post-deploy-application-smoke.ts",
    "ops:diagnose:registration-mentions": "node --env-file-if-exists=.env --import tsx scripts/operations/diagnose-registration-review-mentions.ts",
    "ops:diagnose:admin-opening": "node --env-file-if-exists=.env --import tsx scripts/operations/diagnose-admin-opening-readiness.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "test:watch": "vitest",
    "check": "biome ci . && pnpm typecheck && pnpm test",
    "ops:bootstrap:whatsapp-simulator-db": "node --env-file-if-exists=.env --import tsx scripts/operations/bootstrap-whatsapp-simulator-db.ts",
    "ops:seed:whatsapp-simulator-fixture": "node --env-file-if-exists=.env --import tsx scripts/operations/seed-whatsapp-simulator-fixture.ts",
    "ops:prepare:whatsapp-simulator-gen123": "node --env-file-if-exists=.env --import tsx scripts/operations/prepare-whatsapp-simulator-gen123-content.ts",
    "ops:verify:whatsapp-simulator-local": "node --env-file-if-exists=.env --import tsx scripts/operations/verify-whatsapp-simulator-local.ts",
    "ops:stabilize:whatsapp-simulator-local": "node --env-file-if-exists=.env --import tsx scripts/operations/stabilize-whatsapp-simulator-local.ts",
    "uat:whatsapp:multi": "node --env-file-if-exists=.env --import tsx db/proofs/whatsapp_simulator_multi_actor_uat.ts",
    "uat:whatsapp:deep": "node --env-file-if-exists=.env --import tsx db/proofs/whatsapp_simulator_deep_gameplay_uat.ts",
    "uat:whatsapp:stress": "node --env-file-if-exists=.env --import tsx db/proofs/whatsapp_simulator_stress_uat.ts",
    "uat:whatsapp:full": "pnpm uat:whatsapp:multi && pnpm uat:whatsapp:deep && pnpm uat:whatsapp:stress"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pg": "8.23.0",
    "qrcode-terminal": "0.12.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
