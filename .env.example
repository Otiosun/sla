APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://pokemon:CHANGE_ME@localhost:5432/pokemon_rpg
# Long-running staging/production runtime processes use only DATABASE_URL.
# MIGRATOR_DATABASE_URL is an operator/release credential for migration/bootstrap commands and
# must use a distinct PostgreSQL role when explicitly supplied; it must not be injected into
# the normal Fly/runtime process.
# For the isolated local Control Center developer flow, a loopback PostgreSQL owner credential
# may be used temporarily for both URLs. Never reuse that convenience outside development.
# MIGRATOR_DATABASE_URL=postgresql://pokemon_migrator:CHANGE_ME@localhost:5432/pokemon_rpg
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# Admin API is disabled by default. Enabling it normally requires the exact Control Center
# origin and Cloudflare Access identity boundaries. Never store Access tokens here.
# The standard audience protects ordinary administrative reads. The privileged audience
# must belong to a distinct, more-specific Access application/policy for mutation paths and
# must require the provider-side MFA/step-up policy documented in docs/security/admin-access-step-up.md.
# Staging/production refuse to start the enabled Admin API without both distinct audiences.
# Durable Admin API sessions default to 15 minutes of inactivity and are always capped by
# the signed Cloudflare Access assertion expiry.
# ADMIN_API_ENABLED=false
# ADMIN_API_HOST=127.0.0.1
# ADMIN_API_PORT=8787
# ADMIN_API_ALLOWED_ORIGIN=https://admin-staging.example.com
# ADMIN_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# ADMIN_ACCESS_AUDIENCE=CHANGE_ME_STANDARD_ACCESS_AUD_TAG
# ADMIN_ACCESS_PRIVILEGED_AUDIENCE=CHANGE_ME_PRIVILEGED_ACCESS_AUD_TAG
# ADMIN_ACCESS_SESSION_IDLE_TIMEOUT_MS=900000

# Local Control Center developer mode. This boundary is accepted only with APP_ENV=development,
# a loopback ADMIN_API_HOST, and a loopback browser origin. Generate the UUID with
# `pnpm ops:bootstrap:admin:local`; never invent or copy roles/capabilities into the browser.
# Do not configure Cloudflare Access variables for this local-only mode.
# ADMIN_API_ENABLED=true
# ADMIN_API_HOST=127.0.0.1
# ADMIN_API_PORT=8787
# ADMIN_API_ALLOWED_ORIGIN=http://localhost:5173
# ADMIN_LOCAL_DEV_PRINCIPAL_ID=00000000-0000-4000-8000-000000000000

# WhatsApp runtime is optional in development/test and mandatory in staging/production.
# The auth encryption key must be canonical base64 for exactly 32 random bytes and must live
# in the deployment secret layer, never in Git/Drive/logs. Normal runtime requires a session
# already bootstrapped by the explicit operator flow.
# Release runtimes must also receive the exact full Git SHA deployed. Runtime health evidence
# is written periodically; 30 seconds is the default heartbeat interval.
# WHATSAPP_SESSION_KEY=staging-main
# WHATSAPP_AUTH_KEY_BASE64=CHANGE_ME_32_BYTE_BASE64_SECRET
# WHATSAPP_AUTH_KEY_VERSION=1
# WHATSAPP_OUTBOX_POLL_MS=500
# WHATSAPP_HEALTH_HEARTBEAT_MS=30000
# First-pairing operator ceremony only; default 120000 ms, hard maximum 300000 ms.
# WHATSAPP_PAIRING_TIMEOUT_MS=120000
# DEPLOY_REVISION=0123456789abcdef0123456789abcdef01234567
